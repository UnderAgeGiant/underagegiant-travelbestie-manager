# Copy to local.env (gitignored) and fill in. NEVER commit real values.
# Uncomment a line only when you give it a real value — a blank `KEY=` overrides
# the code default with "" (e.g. empty JWT secret, companion chance 0).
# `npm test` needs none of these.

# --- Core ---
NODE_ENV=development
PORT=3000
# Postgres (PgBouncer) URL without SSL params — src/lib/db.ts appends
# ?channel_binding=require&sslmode=verify-full
# POSTGRES_URL_NO_SSL=
# Required in production (src/lib/validate-env.ts); dev falls back to a fixed dev secret
# JWT_SECRET=
JWT_EXPIRES_IN=2h
# PKCS#8 PEM on one line with \n escapes — generate with: node scripts/generate-keys.js
# Its public half goes in the frontend's BACKEND_RSA_PUBLIC_KEY.
# RSA_PRIVATE_KEY=
FRONTEND_ORIGIN=http://localhost:4200
# Defaults to redis://127.0.0.1:6379; Redis failures are non-fatal
# REDIS_URL=

# --- Email (SMTP) — OTP, receipts, collaborator invites ---
# EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM=

# --- AI ---
# DEEPSEEK_API_KEY=

# --- Payments ---
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# "live" for production; anything else uses the PayPal sandbox
PAYPAL_MODE=sandbox
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# MERCADOPAGO_NOTIFICATION_URL=

# --- Tuning (optional; code defaults shown) ---
# Comma-separated shareIds shown on the landing page
# FEATURED_TRIP_IDS=
# HIGHLIGHT_SEEN_TTL_SECONDS=86400
# COMPANION_SUGGEST_CHANCE=0.20
# COMPANION_SUGGEST_CHANCE_BOOSTED=0.75
# COMPANION_BOOST_DURATION_SECONDS=86400

# --- Read only by the monorepo's lib/ data-pipeline scripts, not by this API ---
# DEEPSEEK_MODEL=
# WIKIMEDIA_TOKEN=
